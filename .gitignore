# -----------------------------------------------------------------------------
# .gitignore — files git should NOT track / push to GitHub
# -----------------------------------------------------------------------------

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Temp / scratch
*.tmp
.tmp*
*.bak
*.log

# Working notes — keep these off the live repo
DEPLOY.md
LOTTIE_GUIDE.md
images/README.txt

# Local archive of working files — never push
_archive/

# Pitch decks — local working files, not for GitHub Pages
decks/

# Collaborator + funder logos kept off the repo.
# Team folder is ignored EXCEPT the founder photo used on the site.
images/team/*
!images/team/Photo_santosh-cropped2.jpg
images/partners/
images/logos/bbsrc.png
images/logos/crh.svg
images/logos/hq.png
images/logos/mrc.png
images/logos/oxford.svg
images/logos/umbizo.gif
# (images/logos/in2cell.svg is the brand mark — kept public)

# Root-level logo duplicates (older copies)
BBSRC.png
CRH.svg
Hq.png
UKRI.png
UMBIZO.gif
university_oxford.svg

# Local demo pages — not for the live repo
_demo/

# If you ever add tooling (npm, yarn, build scripts)
node_modules/
dist/
build/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archives / backups
*.zip
*.tar
*.tar.gz
*.7z

new_updated_website/
_parked-content.md

# Founder bio page — kept locally, not published for now
founder.html

# Publications page — hidden for now
publications.html
.DS_Store
._*

# Team page - hidden for now
team.html
